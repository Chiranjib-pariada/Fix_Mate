# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration (MongoDB or local persistent data store)
MONGO_URI="mongodb://localhost:27017/fixmate"

# Authentication
JWT_SECRET="fixmate_super_secret_jwt_key_2026"
CLIENT_URL="http://localhost:3000"
SERVER_URL="http://localhost:3000"

# Payment Gateway (Razorpay / Stripe)
RAZORPAY_KEY_ID="rzp_test_mock_key_id"
RAZORPAY_KEY_SECRET="rzp_test_mock_secret"

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY="demo_key"
CLOUDINARY_API_SECRET="demo_secret"

# Transactional Email
EMAIL_HOST="smtp.mailtrap.io"
EMAIL_PORT="2525"
EMAIL_USER="mailtrap_user"
EMAIL_PASSWORD="mailtrap_password"
